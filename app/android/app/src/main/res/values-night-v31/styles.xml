<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The dark-mode twin of values-v31/styles.xml, and it has to exist: "night"
         outranks "version" in Android's qualifier precedence, so on a dark-mode
         API 31+ device values-night/styles.xml wins outright and the v31 file is
         never read - a white splash on the very devices that are dark. A Light
         parent here would hand the platform's light window attributes to those
         same devices. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/pi_page_bg</item>
    </style>
</resources>
