<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app opens a WebSocket to the hub, so INTERNET must be in the MAIN
         manifest. It also appears in the debug/profile manifests, but those are
         merged only into their own build types; release merges main alone. Do
         not "deduplicate" this into the debug/profile manifests — that silently
         strips networking from release builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Settles are surfaced as notifications while the app is backgrounded.
         POST_NOTIFICATIONS is a runtime permission on API 33+; the service
         still runs without it. The foreground service keeps the local hub
         WebSocket connected so settles keep arriving, typed `specialUse`
         because a `dataSync` service is time-capped. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <application
        android:enableOnBackInvokedCallback="true"
        android:label="pi_droid"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Keeps the Dart isolate's WebSocket alive while the app is
             backgrounded, so a settle can still raise a notification. A native
             service, not a Dart-isolate plugin, because the hub client lives in
             the main isolate. `stopWithTask` tears it down with the task so the
             persistent notification cannot linger after a swipe-away. -->
        <service
            android:name=".HubConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keeps the local hub WebSocket connected for session notifications" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
