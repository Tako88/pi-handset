{
  "name": "pi-handset-pc",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-handset-bridge.ts"
    ]
  },
  "bin": {
    "pi-handset": "./src/cli/main.ts"
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.ts' 'test/**/*.test.ts' 'extensions/**/*.test.ts'",
    "serve": "node src/cli/main.ts serve",
    "pair": "node src/cli/main.ts pair",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.0"
  }
}
