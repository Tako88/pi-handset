{
  "version": 1,
  "vectors": [
    {
      "name": "lan only",
      "kind": "canonical",
      "uri": "pihandset://pair?v=1&code=ABCD2345&port=8787&lan=192.168.1.10",
      "pairing": {
        "code": "ABCD2345",
        "viewerPort": 8787,
        "addresses": [{ "kind": "lan", "host": "192.168.1.10" }]
      }
    },
    {
      "name": "tailscale only",
      "kind": "canonical",
      "uri": "pihandset://pair?v=1&code=ABCD2345&port=8787&ts=100.64.1.2",
      "pairing": {
        "code": "ABCD2345",
        "viewerPort": 8787,
        "addresses": [{ "kind": "ts", "host": "100.64.1.2" }]
      }
    },
    {
      "name": "both kinds with a repeated lan",
      "kind": "canonical",
      "uri": "pihandset://pair?v=1&code=ABCD2345&port=8787&lan=10.0.0.5&lan=192.168.1.10&ts=100.64.1.2",
      "pairing": {
        "code": "ABCD2345",
        "viewerPort": 8787,
        "addresses": [
          { "kind": "lan", "host": "10.0.0.5" },
          { "kind": "lan", "host": "192.168.1.10" },
          { "kind": "ts", "host": "100.64.1.2" }
        ]
      }
    },
    {
